{
  "name": "dsh-sidebar-session-delete",
  "version": "0.3.0",
  "type": "module",
  "description": "Adds a permanent Delete action to the DeepSeek Harness sidebar session menu.",
  "license": "MIT",
  "author": "Ethan Guan (https://github.com/Ethan-Guan)",
  "homepage": "https://github.com/Ethan-Guan/dsh-sidebar-session-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-Guan/dsh-sidebar-session-delete.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs"
  }
}
